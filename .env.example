# NextAuth
NEXTAUTH_SECRET=replace-with-long-random-string
NEXTAUTH_URL=http://localhost:3000

# IP allowlist (comma-separated). Leave empty to disable check during dev.
ALLOWED_IPS=

# Time window (Asia/Riyadh, 24h HH:MM). Leave empty to disable.
ALLOWED_HOURS_START=07:00
ALLOWED_HOURS_END=22:00

# Seed user (single credentials-based login for MVP).
# Set ONE of these — SEED_USER_PASSWORD takes precedence when both are present.
SEED_USER_EMAIL=ceo@hamzah.sa
SEED_USER_PASSWORD=
# Optional: bcrypt hash alternative. Generate with:
# node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
SEED_USER_PASSWORD_HASH=
